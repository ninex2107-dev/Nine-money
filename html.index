<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nine App</title>
    <style>
        /* ตั้งค่าพื้นฐาน (CSS) สีและรูปแบบ */
        :root {
            --bg-dark: #121824;
            --bg-card: #1e2636;
            --text-main: #ffffff;
            --text-muted: #8892b0;
            --primary: #f59e0b;
            --primary-hover: #d97706;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #000;
            display: flex;
            justify-content: center;
            color: var(--text-main);
        }

        /* จำลองหน้าจอมือถือ */
        #app-container {
            width: 100%;
            max-width: 400px;
            height: 100vh;
            background-color: var(--bg-dark);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 20px rgba(255,255,255,0.1);
        }

        /* ส่วนหัว (Header) */
        header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #2a3441;
        }
        
        .logo {
            color: var(--primary);
            font-size: 28px;
            font-weight: bold;
            margin: 0;
            font-style: italic;
        }

        /* หน้าหลัก (Main Page) */
        #main-page {
            flex: 1;
            display: flex;
            flex
